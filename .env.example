# ─── PropMind — environment configuration ────────────────────────────────────
# Copy this file to `.env` for local development, or set the same keys in your
# hosting provider's environment dashboard. Every variable is optional except
# ANTHROPIC_API_KEY (the AI chat needs it). See README.md for full instructions.

# ── Required ──────────────────────────────────────────────────────────────
# Claude API key — powers the chat widget (Sarah) and Smart Listing Paste.
ANTHROPIC_API_KEY=

# ── Required for the admin dashboard ───────────────────────────────────────
# Long random string. Every /api/admin/* request must send it via the
# x-admin-secret (or Authorization: Bearer) header. The dashboard asks for it
# at login. Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── Optional: AI extras ────────────────────────────────────────────────────
# Gemini key used by Smart Listing Paste (free tier at aistudio.google.com).
# If unset, paste-extraction falls back to Claude.
GEMINI_API_KEY=

# ── Database — Turso (cloud SQLite) for production persistence ─────────────
# Without these, the app uses a local file (./propmind.db) — fine for dev, but
# on most free hosting tiers the file is wiped on every redeploy. For any
# production host, create a free Turso DB and set both:
#   turso db create propmind
#   turso db show propmind --url      → TURSO_URL
#   turso db tokens create propmind   → TURSO_TOKEN
TURSO_URL=
TURSO_TOKEN=

# ── Agency identity ─────────────────────────────────────────────────────────
# Used as the default tenant + shown on the homepage.
AGENCY_NAME=PropMind Real Estate
# AGENCY_SLUG=propmind   (defaults to a slugified AGENCY_NAME)
AGENT_EMAIL=

# ── Email notifications (Gmail app password) ───────────────────────────────
# Captured leads are emailed to AGENT_EMAIL. Use a 16-character Gmail APP
# password (Google Account → Security → 2-Step Verification → App passwords),
# NOT your normal Gmail password.
EMAIL_PASSWORD=

# ── Generic SMTP (alternative to Gmail above) ──────────────────────────────
# If SMTP_HOST is set, email goes through this server instead of Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────────────────
# Optional. When set, agency contacts that are phone numbers get WhatsApp
# notifications instead of email. Requires Meta app approval.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Rate limiting (public endpoints) ───────────────────────────────────────
# Requests per window per visitor IP.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
